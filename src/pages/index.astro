---
import '../styles/global.css';
import PodcastsIsland from '../components/Podcasts';
import WritingIsland from '../components/Writing';
import { drupalcons } from '../data/drupalcons';
import { podcasts } from '../data/podcasts';
import { writing } from '../data/writing';
import { certs } from '../data/certs';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Josh Miller — DevRel Portfolio</title>
  <meta name="description" content="Josh Miller — Drupal contributor, Director of Web at the Urban Institute, MCP module core team member. DevRel portfolio." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="page">

    <!-- Topbar -->
    <div class="topbar">
      <div>
        <span style="color: var(--ink-2); font-weight: 500;">portfolio.joshnliz.com</span>
        <span style="margin: 0 10px; color: var(--rule);">/</span>
        <span>v1 · May 2026</span>
      </div>
      <nav class="nav">
        <a href="#now">now</a>
        <a href="#drupalcon">drupalcon</a>
        <a href="#speaking">podcasts</a>
        <a href="#writing">writing</a>
        <a href="#credentials">credentials</a>
      </nav>
    </div>

    <!-- Hero -->
    <header class="hero">
      <div class="hero-inner">
        <div>
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 22px; flex-wrap: wrap;">
            <span class="status-pill">
              <span class="status-dot"></span>
              currently: shipping MCP for Drupal
            </span>
            <span style="font-family: var(--font-mono); font-size: 12px; color: var(--ink-3);">
              updated May 2026 · Indianapolis, IN
            </span>
          </div>
          <h1>Josh Miller</h1>
          <p class="lede">
            Drupal contributor since 2007. Director of Web at the Urban Institute. On the core team for the <em style="font-style: italic; color: var(--accent);">official Drupal MCP module</em>. Spoken at most DrupalCons since 2014. Maintainer of about thirty contrib modules — most in Commerce.
          </p>
          <div class="hero-row">
            <a href="https://drupal.org/u/joshmiller" target="_blank" rel="noopener noreferrer">drupal.org/u/joshmiller</a>
            <a href="https://www.linkedin.com/in/josh3/recent-activity/all/" target="_blank" rel="noopener noreferrer">linkedin.com/in/josh3</a>
            <a href="https://github.com/joshmiller83" target="_blank" rel="noopener noreferrer">github.com/joshmiller83</a>
            <a href="https://urban.org/author/josh-miller" target="_blank" rel="noopener noreferrer">urban.org/author/josh-miller</a>
            <span style="color: var(--ink-3);">·</span>
            <span style="color: var(--ink-3); font-size: 12px;">Washington, DC · UTC−5</span>
          </div>
        </div>
        <div class="hero-photo">
          <img
            src="/images/mcp-chicago-2026.jpg"
            alt="Josh Miller demoing the Drupal MCP module at the Pantheon expo booth, DrupalCon Chicago 2026"
            loading="eager"
          />
          <div class="hero-photo-cap">
            <a href="https://youtu.be/MkmSpV2l_1k" target="_blank" rel="noopener noreferrer"><span class="accent">▸ Live MCP demo</span></a> · Pantheon booth · DrupalCon Chicago, May 2026
          </div>
        </div>
      </div>
    </header>

    <!-- §01 Right Now -->
    <section id="now">
      <div class="section-head">
        <div class="section-num">§ 01</div>
        <h2 class="section-title">Right now</h2>
        <div class="section-sub">three live threads — not a roadmap, not a wishlist</div>
      </div>
      <div class="now">
        <div class="now-cell">
          <div class="now-tag">this quarter</div>
          <h3 class="now-h">Drupal MCP module — core team</h3>
          <p class="now-p">On the team shipping the official Model Context Protocol module so AI clients can read and write Drupal sites through Anthropic's protocol. First release lands this summer.</p>
        </div>
        <div class="now-cell">
          <div class="now-tag">this month</div>
          <h3 class="now-h">DrupalCon Chicago 2026 follow-up</h3>
          <p class="now-p">Following up on the Tim Lehnen fireside, the agentic interfaces breakout, and the MCP live demo at the Pantheon expo booth. Writing up the demo for those who couldn't attend.</p>
        </div>
        <div class="now-cell">
          <div class="now-tag">ongoing</div>
          <h3 class="now-h">AI governance, in public</h3>
          <p class="now-p">Posting on LinkedIn about MCP adoption, agentic UX for content systems, and what 'AI governance' actually means for editorial teams who can't afford to get this wrong.</p>
        </div>
      </div>
    </section>

    <!-- §02 DrupalCon Timeline -->
    <section id="drupalcon">
      <div class="section-head">
        <div class="section-num">§ 02</div>
        <h2 class="section-title">DrupalCon, 2014 → present</h2>
        <div class="section-sub">every cycle I've spoken at · breakout, summit, and expo-booth sessions · ★ most recent</div>
      </div>
      <div class="timeline">
        {drupalcons.map(c => (
          <a href={c.url} target="_blank" rel="noopener noreferrer" class={`tl-row${c.featured ? ' featured' : ''}`}>
            <div class="tl-year">{c.year}</div>
            <div class="tl-city">{c.city}</div>
            <div class="tl-title">{c.talk}</div>
            <div class="tl-rec">{c.rec === 'youtube' ? '▸ watch' : '▸ session'}</div>
          </a>
        ))}
      </div>
      <div style="font-family: var(--font-mono); font-size: 11px; color: var(--ink-3); margin-top: 12px; line-height: 1.6;">
        Note: summit sessions at DrupalCon are typically not recorded; the session links above point to event pages where available.
      </div>
    </section>

    <!-- Dingbat -->
    <div class="dingbat" aria-hidden="true">⁂</div>

    <!-- §03 Podcasts -->
    <section id="speaking">
      <div class="section-head">
        <div class="section-num">§ 03</div>
        <h2 class="section-title">Podcasts &amp; conversations</h2>
        <div class="section-sub">five Talking Drupal episodes · filter by topic</div>
      </div>
      <PodcastsIsland podcasts={podcasts} client:load />
    </section>

    <!-- §04 Writing -->
    <section id="writing">
      <div class="section-head">
        <div class="section-num">§ 04</div>
        <h2 class="section-title">Writing, in full</h2>
        <div class="section-sub">recent LinkedIn essays — pull quote up top, click to read the rest in place</div>
      </div>
      <WritingIsland writing={writing} client:load />
    </section>

    <!-- Dingbat -->
    <div class="dingbat" aria-hidden="true">⁂</div>

    <!-- §05 Credentials (reverse) -->
    <section id="credentials" class="reverse">
      <div class="section-head">
        <div class="section-num">§ 05</div>
        <h2 class="section-title">Credentials</h2>
        <div class="section-sub">20 active certifications · weighted toward AI governance, MCP, and federal-compliance work</div>
      </div>

      {certs.map(group => (
        <div class="cert-group">
          <h3 class="cert-group-h">{group.group}</h3>
          <div class="cert-list">
            {group.items.map(c => (
              <div class="cert">
                <div class="cert-name">
                  {c.url
                    ? <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
                    : c.name}
                </div>
                <div class="cert-by">{c.by}</div>
                <div class="cert-date">{c.date}</div>
              </div>
            ))}
          </div>
        </div>
      ))}

      <div style="font-family: var(--font-mono); font-size: 11px; color: rgba(237,228,207,0.55); margin-top: 16px; line-height: 1.6;">
        The cluster pattern is intentional: Anthropic MCP → Purdue AI policy → NIST/FedRAMP/GRC. The Acquia Backend cert from 2018 anchors the Drupal side.
      </div>
    </section>

    <!-- Colophon -->
    <footer class="colophon">
      <div>
        <h4>Contact</h4>
        <p><a href="https://www.linkedin.com/in/josh3/" target="_blank" rel="noopener noreferrer">LinkedIn DM</a> · preferred</p>
        <p>Indianapolis, IN · UTC−5</p>
        <p>open to: speaking, consulting, new roles</p>
      </div>
      <div>
        <h4>Identifiers</h4>
        <p><a href="https://drupal.org/u/joshmiller" target="_blank" rel="noopener noreferrer">drupal.org/u/joshmiller</a></p>
        <p><a href="https://github.com/joshmiller83" target="_blank" rel="noopener noreferrer">github.com/joshmiller83</a></p>
        <p><a href="https://www.linkedin.com/in/josh3/recent-activity/all/" target="_blank" rel="noopener noreferrer">linkedin.com/in/josh3</a></p>
        <p><a href="https://twitter.com/MrJoshMiller" target="_blank" rel="noopener noreferrer">twitter.com/MrJoshMiller</a></p>
        <p><a href="https://urban.org/author/josh-miller" target="_blank" rel="noopener noreferrer">urban.org/author/josh-miller</a></p>
      </div>
      <div>
        <h4>Colophon</h4>
        <p>portfolio.joshnliz.com</p>
        <p>Newsreader · IBM Plex Sans · IBM Plex Mono</p>
        <p>No analytics. No tracking pixels.</p>
      </div>
    </footer>

  </div>
</body>
</html>
